@{
    var title = ViewData["Title"] ?? "Farmer Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@title - MarketLink</title>


    <!-- Google Fonts -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


    <!-- Farmer Dashboard CSS -->

    <link rel="stylesheet"
          href="~/css/farmerdashboard.css"
          asp-append-version="true" />

</head>


<body class="farmer-dashboard-body">


    <!-- MOBILE OVERLAY -->

    <div class="farmer-overlay"
         id="farmerOverlay">
    </div>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="farmer-sidebar"
           id="farmerSidebar">


        <!-- BRAND -->

        <div class="farmer-brand">

            <a asp-controller="Home"
               asp-action="Index"
               class="farmer-logo">

                <span class="farmer-logo-icon">
                    <i class="bi bi-basket-fill"></i>
                </span>

                <span>
                    Market<span>Link</span>
                </span>

            </a>


            <button type="button"
                    class="farmer-sidebar-close"
                    id="farmerSidebarClose">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <!-- FARMER PROFILE -->

        <div class="farmer-mini-profile">

            <div class="farmer-avatar">
                F
            </div>

            <div>

                <strong>Green Valley Farm</strong>

                <span>Farmer Account</span>

            </div>

        </div>


        <!-- NAVIGATION -->

        <nav class="farmer-menu">


            <div class="farmer-menu-heading">
                FARMER CENTER
            </div>


            <a href="#"
               class="farmer-menu-link active">

                <i class="bi bi-grid-1x2-fill"></i>

                <span>Dashboard</span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-person"></i>

                <span>My Profile</span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-shop"></i>

                <span>My Markets</span>

            </a>


            <div class="farmer-menu-heading farmer-second-heading">
                PRODUCTS & STOCK
            </div>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-basket"></i>

                <span>My Products</span>

                <span class="farmer-count">
                    18
                </span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-box-seam"></i>

                <span>Inventory</span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-calendar3"></i>

                <span>Weekly Stock</span>

            </a>


            <div class="farmer-menu-heading farmer-second-heading">
                ORDERS & SALES
            </div>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-receipt"></i>

                <span>Orders</span>

                <span class="farmer-count orange">
                    5
                </span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-clock-history"></i>

                <span>Pickup Slots</span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-graph-up-arrow"></i>

                <span>Sales History</span>

            </a>


            <div class="farmer-menu-heading farmer-second-heading">
                CUSTOMER FEEDBACK
            </div>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-star"></i>

                <span>Reviews</span>

            </a>


            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-bell"></i>

                <span>Notifications</span>

                <span class="farmer-notification-dot"></span>

            </a>


        </nav>


        <!-- SIDEBAR BOTTOM -->

        <div class="farmer-sidebar-bottom">

            <a href="#"
               class="farmer-menu-link">

                <i class="bi bi-question-circle"></i>

                <span>Help & Support</span>

            </a>


            <a asp-controller="Home"
               asp-action="Index"
               class="farmer-menu-link farmer-back-link">

                <i class="bi bi-box-arrow-left"></i>

                <span>Back to Website</span>

            </a>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <div class="farmer-main">


        <!-- TOPBAR -->

        <header class="farmer-topbar">


            <div class="farmer-top-left">

                <button type="button"
                        class="farmer-sidebar-toggle"
                        id="farmerSidebarToggle">

                    <i class="bi bi-list"></i>

                </button>


                <div>

                    <span>Farmer Center</span>

                    <h1>@title</h1>

                </div>

            </div>


            <div class="farmer-top-actions">


                <button type="button"
                        class="farmer-top-icon">

                    <i class="bi bi-search"></i>

                </button>


                <button type="button"
                        class="farmer-top-icon farmer-notification">

                    <i class="bi bi-bell"></i>

                    <span></span>

                </button>


                <div class="farmer-top-user">

                    <div class="farmer-top-avatar">
                        F
                    </div>

                    <div>

                        <strong>Green Valley Farm</strong>

                        <small>Farmer</small>

                    </div>

                    <i class="bi bi-chevron-down"></i>

                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->

        <main class="farmer-content">

            @RenderBody()

        </main>

    </div>


    <!-- BOOTSTRAP JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- SIDEBAR JS -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const sidebar =
                    document.getElementById("farmerSidebar");

                const toggle =
                    document.getElementById("farmerSidebarToggle");

                const close =
                    document.getElementById("farmerSidebarClose");

                const overlay =
                    document.getElementById("farmerOverlay");


                toggle?.addEventListener("click", function() {

                    sidebar.classList.add("show");

                    overlay.classList.add("show");

                });


                close?.addEventListener("click", function() {

                    sidebar.classList.remove("show");

                    overlay.classList.remove("show");

                });


                overlay?.addEventListener("click", function() {

                    sidebar.classList.remove("show");

                    overlay.classList.remove("show");

                });

            });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>