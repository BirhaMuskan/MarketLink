                <div class="farmer-card">

                    <div class="farmer-image">
                        <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=700&q=85"
                             alt="Bilal Ahmed">

                        <span class="verified-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            Verified
                        </span>
                    </div>

                    <div class="farmer-content">

                        <div class="farmer-name-row">
                            <div>
                                <h3>Bilal Ahmed</h3>
                                <span>Pure Fields Farm</span>
                            </div>

                            <button class="favorite-farmer"
                                    type="button"
                                    aria-label="Favorite farmer">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="farmer-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            Karachi, Sindh
                        </div>

                        <p>
