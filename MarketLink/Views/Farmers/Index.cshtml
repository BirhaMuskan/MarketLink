                <div class="farmer-card">

                    <div class="farmer-image">
                        <img src="https://images.unsplash.com/photo-1537519646099-335112f03225?auto=format&fit=crop&w=700&q=85"
                             alt="Sana Malik">

                        <span class="verified-badge">
                            <i class="bi bi-patch-check-fill"></i>
