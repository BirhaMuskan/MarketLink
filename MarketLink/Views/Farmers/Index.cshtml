<!-- =========================
     WHY SUPPORT FARMERS
========================= -->
<section class="support-farmers">

    <div class="container">

        <div class="section-heading text-center">
            <span>WHY SHOP LOCAL?</span>

            <h2>
                Support Your <strong>Local Farmers</strong>
            </h2>

            <p>
                Every purchase helps strengthen local communities and
                supports the people who grow our food.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-basket2-fill"></i>
                    </div>

                    <h3>Fresh Produce</h3>

                    <p>
                        Get fresh products sourced directly from local farms.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3>Support Farmers</h3>

                    <p>
                        Help local farmers grow their businesses and
                        communities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <h3>Shop Locally</h3>

                    <p>
                        Discover quality food from farms around your area.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h3>Build Community</h3>

                    <p>
                        Create stronger connections between farmers and
                        families.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- =========================
     CTA
========================= -->
<section class="farmer-cta">

    <div class="container">

        <div class="farmer-cta-inner">

            <div>
                <span>GROW LOCAL. SHOP LOCAL.</span>

                <h2>
                    Discover Freshness<br />
                    From Local Farms
                </h2>

                <p>
                    Find farmers near you and explore their fresh products.
                </p>
            </div>

            <div class="cta-buttons">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-light">
                    <i class="bi bi-basket2"></i>
                    Browse Products
                </a>

                <a asp-controller="Markets"
                   asp-action="Index"
                   class="btn btn-outline-light">
                    Find Markets
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</section>


@section Styles {

    <style>

        /* =========================
               FARMERS HERO
            ========================= */

        .farmers-hero {
            padding: 90px 0 85px;
            background: linear-gradient(135deg, #f4fbf5 0%, #ffffff 55%, #eef8f1 100%);
            overflow: hidden;
        }

        .farmers-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            margin-bottom: 20px;
            border-radius: 50px;
            background: #e4f4e8;
            color: #24864a;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .farmers-badge i {
                font-size: 16px;
            }

        .farmers-hero h1 {
            max-width: 700px;
            margin-bottom: 22px;
            color: #173b28;
            font-size: clamp(40px, 5vw, 68px);
            line-height: 1.08;
            font-weight: 800;
        }

            .farmers-hero h1 span {
                display: block;
                color: #2c9955;
            }

        .farmers-hero p {
            max-width: 620px;
            margin-bottom: 30px;
            color: #63736a;
            font-size: 17px;
            line-height: 1.8;
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-farmer-primary,
        .btn-farmer-outline {
            min-height: 50px;
            padding: 13px 23px;
            border-radius: 12px;
            font-weight: 700;
        }

        .btn-farmer-primary {
            color: #fff;
            background: #2d9955;
            border: 1px solid #2d9955;
        }

            .btn-farmer-primary:hover {
                color: #fff;
                background: #237c44;
                border-color: #237c44;
                transform: translateY(-2px);
            }

        .btn-farmer-outline {
            color: #267f47;
            background: #fff;
            border: 1px solid #cce4d3;
        }

            .btn-farmer-outline:hover {
                color: #267f47;
                background: #edf8f0;
                border-color: #b7dbbf;
            }

        .farmer-hero-stats {
            display: flex;
            gap: 35px;
            margin-top: 40px;
            flex-wrap: wrap;
        }

            .farmer-hero-stats div {
                display: flex;
                flex-direction: column;
            }

            .farmer-hero-stats strong {
                color: #1d5633;
                font-size: 28px;
                line-height: 1;
            }

            .farmer-hero-stats span {
                margin-top: 7px;
                color: #77857c;
                font-size: 13px;
            }

        .farmers-hero-image {
            position: relative;
            padding: 12px;
        }

            .farmers-hero-image::before {
                content: "";
                position: absolute;
                top: -20px;
                right: -20px;
                width: 180px;
                height: 180px;
                border-radius: 50%;
                background: #dff2e4;
                z-index: 0;
            }

            .farmers-hero-image img {
                position: relative;
                z-index: 1;
                width: 100%;
                height: 520px;
                object-fit: cover;
                border-radius: 30px;
                box-shadow: 0 25px 60px rgba(34, 77, 48, 0.16);
            }

        .hero-floating-card {
            position: absolute;
            z-index: 2;
            left: -15px;
            bottom: 45px;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 15px 18px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(27, 67, 42, 0.15);
        }

        .floating-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: #e7f6eb;
            color: #2b9653;
            font-size: 21px;
        }

        .hero-floating-card strong {
            display: block;
            color: #244332;
            font-size: 14px;
        }

        .hero-floating-card small {
            color: #849087;
            font-size: 12px;
        }


        /* =========================
               FARMERS SECTION
            ========================= */

        .farmers-section {
            padding: 95px 0;
            background: #fff;
        }

        .section-heading {
            max-width: 720px;
            margin: 0 auto 45px;
        }

            .section-heading span {
                display: block;
                margin-bottom: 10px;
                color: #2b9653;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.8px;
            }

            .section-heading h2 {
                margin-bottom: 14px;
                color: #193d29;
                font-size: clamp(30px, 4vw, 44px);
                font-weight: 800;
            }

                .section-heading h2 strong {
                    color: #2c9955;
                }

            .section-heading p {
                margin: 0;
                color: #758078;
                line-height: 1.8;
            }


        /* FILTER */

        .farmers-filter-box {
            padding: 18px;
            margin-bottom: 40px;
            background: #f6faf7;
            border: 1px solid #e1eee4;
            border-radius: 18px;
        }

        .farmer-search {
            position: relative;
        }

            .farmer-search i {
                position: absolute;
                top: 50%;
                left: 17px;
                z-index: 2;
                color: #789082;
                transform: translateY(-50%);
            }

            .farmer-search input {
                height: 50px;
                padding-left: 45px;
                border: 1px solid #dce9df;
                border-radius: 12px;
            }

                .farmer-search input:focus,
                .farmers-filter-box select:focus {
                    border-color: #70b687;
                    box-shadow: 0 0 0 3px rgba(45, 153, 85, 0.08);
                }

        .farmers-filter-box select {
            height: 50px;
            border-color: #dce9df;
            border-radius: 12px;
        }

        .btn-reset {
            height: 50px;
            color: #36714a;
            background: #fff;
            border: 1px solid #d5e7da;
            border-radius: 12px;
            font-weight: 600;
        }

            .btn-reset:hover {
                color: #fff;
                background: #2d9955;
                border-color: #2d9955;
            }


        /* FARMER CARD */

        .farmer-card {
            height: 100%;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e5eee7;
            border-radius: 20px;
            box-shadow: 0 8px 28px rgba(32, 71, 45, 0.06);
            transition: all .3s ease;
        }

            .farmer-card:hover {
                transform: translateY(-7px);
                border-color: #cae2d0;
                box-shadow: 0 18px 45px rgba(32, 71, 45, 0.12);
            }

        .farmer-image {
            position: relative;
            height: 245px;
            overflow: hidden;
        }

            .farmer-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .5s ease;
            }

