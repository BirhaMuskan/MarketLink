@model MarketLink.ViewModels.FarmerInventoryPageViewModel

@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_FarmerDashboardLayout.cshtml";
}

<section class="inv-header">
    <div>
        <span class="inv-label">
            <i class="bi bi-box-seam"></i>
            PRODUCTS & STOCK
        </span>

        <h2>Inventory</h2>

        <p>
            Monitor current stock, reservations, sold quantity and availability by market.
        </p>
    </div>

    <a asp-controller="FarmerWeeklyStock"
       asp-action="Index"
       class="inv-primary-btn">
        <i class="bi bi-calendar-repeat"></i>
        Weekly Stock
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["ErrorMessage"]
    </div>
}

<section class="inv-stats">
    <div>
        <span>Inventory Rows</span>
        <strong>@Model.TotalRows</strong>
    </div>

    <div>
        <span>Available Qty</span>
        <strong>@Model.TotalAvailable.ToString("N3")</strong>
    </div>

    <div>
        <span>Reserved</span>
        <strong>@Model.TotalReserved.ToString("N3")</strong>
    </div>

    <div>
        <span>Sold</span>
        <strong>@Model.TotalSold.ToString("N3")</strong>
    </div>
</section>

<section class="inv-card">

    <div class="inv-toolbar">
        <div class="inv-search">
            <i class="bi bi-search"></i>

            <input type="text"
                   id="inventorySearch"
                   placeholder="Search product or market..." />
        </div>
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="inv-empty">
            <i class="bi bi-box-seam"></i>

            <h3>No inventory yet</h3>

            <p>
                Inventory is created when you add a product to one of your markets.
            </p>

            <a asp-controller="FarmerProducts"
               asp-action="Create"
               class="inv-primary-btn">
                Add Product
            </a>
        </div>
    }
    else
    {
        <div class="inv-table-wrap">

            <table class="inv-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Market</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Reserved</th>
                        <th>Sold</th>
                        <th>Available</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Rows)
                    {
                        <tr data-search="@($"{item.ProductName} {item.MarketName}".ToLowerInvariant())">

                            <td>
                                <strong>@item.ProductName</strong>
                                <span class="unit-text">
                                    @item.UnitName
                                </span>
                            </td>

                            <td>@item.MarketName</td>

                            <td>
                                Rs. @item.UnitPrice.ToString("N2")
                            </td>

                            <td>
                                @item.StockQuantity.ToString("N3")
                            </td>

                            <td>
                                @item.ReservedQuantity.ToString("N3")
                            </td>

                            <td>
                                @item.SoldQuantity.ToString("N3")
                            </td>

                            <td>
                                <strong>
                                    @item.AvailableQuantity.ToString("N3")
                                </strong>
                            </td>

                            <td>
                                @if (item.IsSoldOut)
                                {
                                    <span class="status soldout">
                                        Sold Out
                                    </span>
                                }
                                else if (!item.IsAvailable)
                                {
                                    <span class="status unavailable">
                                        Unavailable
                                    </span>
                                }
                                else
                                {
                                    <span class="status available">
                                        Available
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="row-actions">

                                    <a asp-controller="FarmerInventory"
                                       asp-action="Edit"
                                       asp-route-id="@item.InventoryId"
                                       class="row-action">
                                        Edit
                                    </a>

                                    @if (!item.IsSoldOut)
                                    {
                                        <form asp-controller="FarmerInventory"
                                              asp-action="MarkSoldOut"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.InventoryId" />

                                            <button type="submit"
                                                    class="row-action danger">
                                                Sold Out
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>

@section Styles {
<style>
.inv-header{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px}
.inv-label{color:#14836f;font-size:12px;font-weight:800;letter-spacing:.08em}
.inv-header h2{margin:7px 0 5px;font-size:28px;font-weight:800}
.inv-header p{margin:0;color:#667085}
.inv-primary-btn{display:inline-flex;align-items:center;gap:8px;background:#13836e;color:#fff;text-decoration:none;padding:10px 15px;border-radius:10px;font-weight:700}
.inv-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.inv-stats>div{background:#fff;border:1px solid #e7ebef;border-radius:16px;padding:17px}
.inv-stats span{display:block;color:#667085;font-size:12px}
.inv-stats strong{display:block;margin-top:4px;font-size:25px}
.inv-card{background:#fff;border:1px solid #e7ebef;border-radius:18px;overflow:hidden}
.inv-toolbar{padding:15px 17px;border-bottom:1px solid #edf0f4}
.inv-search{max-width:440px;position:relative}
.inv-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#98a2b3}
.inv-search input{width:100%;padding:10px 12px 10px 40px;border:1px solid #d8dee6;border-radius:11px}
.inv-table-wrap{overflow:auto}
.inv-table{width:100%;border-collapse:collapse}
.inv-table th{padding:12px 14px;background:#f8fafc;color:#667085;font-size:10px;text-transform:uppercase;white-space:nowrap}
.inv-table td{padding:14px;border-top:1px solid #edf0f4;font-size:12px;vertical-align:middle;white-space:nowrap}
.unit-text{display:block;color:#98a2b3;font-size:10px}
.status{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:800}
.status.available{background:#dcfae6;color:#067647}
.status.soldout{background:#fee4e2;color:#b42318}
.status.unavailable{background:#f2f4f7;color:#475467}
.row-actions{display:flex;gap:6px}
.row-action{border:1px solid #d9dfe5;background:#fff;color:#344054;padding:6px 8px;border-radius:7px;font-size:10px;font-weight:700;text-decoration:none}
.row-action.danger{color:#b42318;border-color:#f3c8c5}
.inv-empty{text-align:center;padding:65px 20px;color:#667085}
.inv-empty>i{font-size:34px;color:#13836e}
@@media(max-width:800px){.inv-stats{grid-template-columns:repeat(2,1fr)}}
@@media(max-width:550px){.inv-header{flex-direction:column;align-items:stretch}.inv-stats{grid-template-columns:1fr}}
</style>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const search = document.getElementById("inventorySearch");
    const rows = document.querySelectorAll("tbody tr[data-search]");

    search?.addEventListener("input", function () {
        const value = search.value.trim().toLowerCase();

        rows.forEach(row => {
            row.style.display =
                (row.dataset.search || "").includes(value)
                    ? ""
                    : "none";
        });
    });
});
</script>
}
